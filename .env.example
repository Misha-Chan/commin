# توكن البوت الذي تحصل عليه من @BotFather في تيليجرام
TELEGRAM_BOT_TOKEN=

# بيانات قاعدة Turso (احصل عليها بأمر turso db show / turso db tokens create)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# كلمة مرور لوحة الإدارة (اختر كلمة قوية)
ADMIN_PASSWORD=

# سلسلة عشوائية طويلة تُستخدم لتوقيع جلسة تسجيل الدخول (يمكن توليدها بأمر: openssl rand -hex 32)
SESSION_SECRET=
